{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@studio/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": [
    "src/env.d.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "../../packages/shared/src/**/*.ts"
  ]
}
